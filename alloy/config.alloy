// Grafana Alloy Configuration for Railway
// Receives OTLP traces and logs, forwards to Tempo and Loki

// ============================================================================
// OTLP Receiver - Receives traces and logs from applications
// ============================================================================
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs   = [otelcol.processor.batch.logs.input]
    traces = [otelcol.processor.batch.traces.input]
  }
}

// ============================================================================
// Batch Processor - Traces
// ============================================================================
otelcol.processor.batch "traces" {
  timeout         = "5s"
  send_batch_size = 512

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

// ============================================================================
// Batch Processor - Logs
// ============================================================================
otelcol.processor.batch "logs" {
  timeout         = "5s"
  send_batch_size = 512

  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

// ============================================================================
// OTLP Exporter - Send traces to Tempo
// ============================================================================
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo.railway.internal:4318"
  }
}

// ============================================================================
// Loki Exporter - Convert OTLP logs to Loki format
// ============================================================================
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

// ============================================================================
// Loki Write - Send logs to Loki
// ============================================================================
loki.write "default" {
  endpoint {
    url = "http://loki.railway.internal:3100/loki/api/v1/push"
  }
}
